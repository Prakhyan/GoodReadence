{
  "name": "goodreadence-vendored-dependencies",
  "version": "1.6.1",
  "private": true,
  "description": "Pinned versions of libraries served locally by the static GoodReadence app.",
  "scripts": {
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "preview": "node scripts/serve-local.cjs",
    "check:vendor": "node scripts/check-vendor-pins.cjs",
    "test:library": "node scripts/check-library-expansion.cjs",
    "test:library:additions": "node scripts/check-library-additions.cjs",
    "test:presentation": "node scripts/check-library-presentation.cjs",
    "build:static": "node scripts/build-static-site.cjs",
    "test:offline": "node scripts/check-offline-install.cjs",
    "test:discoveries": "node scripts/check-library-order.cjs",
    "test:reader": "node scripts/check-reader-review.cjs",
    "test:mobile": "node scripts/check-mobile-imports.cjs",
    "test:discoverability": "node scripts/check-discoverability.cjs",
    "test:audio": "node scripts/check-audio-files.cjs",
    "test:navigation": "node scripts/check-room-navigation.cjs",
    "test:on-demand": "node scripts/check-on-demand-books.cjs",
    "test:catalogue": "node scripts/check-catalogue-performance.cjs",
    "audit:editions": "node scripts/audit-catalogue-parallel.cjs && node scripts/seal-catalogue-audit.cjs",
    "test:catalogue:review": "node scripts/check-catalogue-review.cjs",
    "library:inventory": "python scripts/plan-catalogue-expansion.py",
    "library:review": "node scripts/review-catalogue-expansion.cjs",
    "test:catalogue:download": "node scripts/check-source-download.cjs",
    "test:home": "node scripts/check-restored-home.cjs",
    "test:product-facts": "node scripts/check-product-contract.cjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
