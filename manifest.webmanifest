{
  "name": "GoodReadence",
  "short_name": "GoodReadence",
  "description": "Your private reading room. Books and notes stay on this device.",
  "id": "/",
  "start_url": "/index.html?library=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f5f2",
  "theme_color": "#f7f5f2",
  "icons": [
    {
      "src": "/icon-192.png?v=1.14.1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png?v=1.14.1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png?v=1.14.1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Your reading room",
      "short_name": "Your books",
      "url": "/index.html?library=1"
    },
    {
      "name": "Public library",
      "url": "/library.html"
    },
    {
      "name": "Help & FAQ",
      "url": "/faq.html"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://goodreadence.vercel.app/manifest.webmanifest",
      "id": "https://goodreadence.vercel.app/"
    }
  ],
  "prefer_related_applications": false
}
